# Copy to .env for local use. In Hugging Face, enter these as Space Secrets.
# Use the existing Neon PostgreSQL URL, including its SSL options.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Optional when Abdulmoiz123/loan-risk-models is public.
HF_TOKEN=

# Optional local Docker Compose settings (development defaults shown).
# Compose uses its PostgreSQL container rather than DATABASE_URL above.
DB_USER=postgres
DB_PASSWORD=localdev
DB_NAME=loan_risk_db
APP_PORT=7860
